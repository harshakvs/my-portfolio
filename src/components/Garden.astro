---
// Digital garden — notes exported from the Obsidian vault to Notion.
// The list is generated by the ship pipeline into src/data/garden.ts; each
// entry links out to its Notion page. Add notes by writing them in the vault
// with `publish: true` and running `python ship.py publish`.
import { garden } from '../data/garden';

const stageLeaf: Record<string, string> = {
  seedling: '🌱', sprouting: '🌿', evergreen: '🌳',
};
const seeds = garden.length
  ? garden
  : [];
---
<section id="garden" class="section">
  <div class="container">
    <h2 class="section-title">tree ./digital_garden</h2>
    <p class="section-sub">
      Raw notes from my Obsidian vault, in public — less polished than articles, more honest.
      {seeds.length ? 'Each links to the full note.' : 'Freshly tilled; first notes landing soon.'}
    </p>

    {seeds.length ? (
      <div class="garden mono">
        {seeds.map((s, i) => (
          <a class="seed" href={s.url} target="_blank" rel="noopener">
            <span class="branch muted">{i === seeds.length - 1 ? '└──' : '├──'}</span>
            <span class="leaf">{stageLeaf[s.stage] ?? '🌱'}</span>
            <div>
              <span class="name">{s.name}</span>
              {s.desc && <span class="desc muted"> — {s.desc}</span>}
              {s.tags?.length ? (
                <span class="tags muted"> {s.tags.map((t) => `#${t}`).join(' ')}</span>
              ) : null}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="garden mono empty muted">
        └── 🌱 <span>nothing published yet — <code>python ship.py publish</code></span>
      </div>
    )}
  </div>
</section>

<style>
  .garden { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px 26px; font-size: 0.84rem; }
  .seed { display: flex; gap: 10px; padding: 5px 0; align-items: baseline; text-decoration: none; color: inherit; }
  a.seed:hover .name { text-decoration: underline; }
  .leaf { font-size: 0.8rem; }
  .name { color: var(--accent2); }
  .desc { font-size: 0.78rem; }
  .tags { font-size: 0.72rem; }
  .empty { display: flex; gap: 8px; align-items: baseline; }
</style>
